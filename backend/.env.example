PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/talent_forge
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_USERNAME=admin
# Generate a bcrypt hash for ADMIN_PASSWORD_HASH; do not store plain passwords here.
ADMIN_PASSWORD_HASH=
FRONTEND_ORIGIN=http://localhost:5173

# SMTP configuration from the company-approved email provider
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Talent Forge <contact@alphaauron.com>
# The 3 people who get an email for EVERY new enquiry: the two addresses below + EMPLOYEE_EMAIL.
# Add or remove addresses here (comma separated). Each person gets a separate email.
NOTIFY_EMAILS=krish@alphaauron.com,santhan@alphaauron.com
EMPLOYEE_EMAIL=tejaswi@alphaauron.com
# Link inside the team emails that opens the admin dashboard
ADMIN_DASHBOARD_URL=http://localhost:5173/admin
# Max enquiries per IP per 15 minutes (stops spam to the team and to third-party addresses)
LEAD_RATE_LIMIT=20
OFFICIAL_MEMBERSHIP_URL=https://alphaauron.com/talent-forge
